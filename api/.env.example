# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection. Local: postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/sentio
# Neon: paste the connection string as-is (postgresql://...?sslmode=require) - it is converted automatically
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/sentio

# Long random string (32+ characters) that signs login tokens.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=60

# False = use the trained model via the model service (ML/serve.py)
# True  = use the keyword placeholder (no model needed)
USE_FAKE_MODEL=False
ML_SERVICE_URL=http://localhost:8001
# Shared secret for the model service. Leave empty on your own laptop.
# When the model is public through ngrok, set the same value here and as
# ML_SERVICE_TOKEN before starting ML/serve.py.
ML_SERVICE_TOKEN=

# Websites allowed to call the API, comma-separated (add your Vercel URL when deployed)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
